def check_feasibility(ingot_fraction, quantities, target_weight):
    """Check if the target batch is feasible with available quantities"""
    ingot_needed = ingot_fraction * target_weight
    remaining_fraction = 1.0 - ingot_fraction
    remaining_needed = remaining_fraction * target_weight
    
    issues = []
    warnings = []
    
    # Check ingot availability
    ingot_available = quantities.get('AA6061-I', 0)
    if ingot_needed > ingot_available:
        issues.append({
            'type': 'INGOT_SHORTAGE',
            'material': 'AA6061-I',
            'needed': ingot_needed,
            'available': ingot_available,
            'shortage': ingot_needed - ingot_available
        })
    
    # Check if any other scrap is available
    other_scraps = [name for name in SCRAP_MATERIALS.keys() if name != 'AA6061-I']
    total_other_available = sum(quantities.get(s, 0) for s in other_scraps)
    
    if total_other_available < remaining_needed:
        issues.append({
            'type': 'TOTAL_OTHER_SHORTAGE',
            'needed': remaining_needed,
            'available': total_other_available,
            'shortage': remaining_needed - total_other_available
        })
    
    return issues, warnings


