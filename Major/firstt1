def calculate_mixed_composition(ingot_fraction, other_fractions):
    """Calculate final composition from AA6061-I + other scraps"""
    composition = {elem: 0.0 for elem in ELEMENTS}
    
    for elem in ELEMENTS:
        composition[elem] += SCRAP_MATERIALS['AA6061-I'][elem] * ingot_fraction
    
    for material, fraction in other_fractions.items():
        for elem in ELEMENTS:
            composition[elem] += SCRAP_MATERIALS[material][elem] * fraction
    
    return composition


def calculate_composition_score(composition):
    """Calculate how close composition is to ideal 6061 center"""
    score = 0
    for elem in ELEMENTS:
        min_val, max_val = TARGET_6061[elem]
        center = (min_val + max_val) / 2
        range_size = max_val - min_val if max_val > min_val else 0.1
        
        val = composition[elem]
        
        if val < min_val:
            score += ((min_val - val) / range_size * 100) ** 2
        elif val > max_val:
            score += ((val - max_val) / range_size * 100) ** 2
        else:
            score += ((val - center) / range_size * 10) ** 2
    
    return score


def check_6061_compliance(composition):
    """Check if composition meets adjusted 6061 specifications"""
    violations = []
    all_ok = True
    
    for elem, (min_val, max_val) in TARGET_6061.items():
        val = composition[elem]
        if val < min_val:
            violations.append((elem, val, min_val, max_val, 'LOW'))
            all_ok = False
        elif val > max_val:
            violations.append((elem, val, min_val, max_val, 'HIGH'))
            all_ok = False
    
    return all_ok, violations


def optimize_with_quantities(ingot_fraction, quantities, target_weight):
    """Find optimal combination considering quantity constraints"""
    remaining_fraction = 1.0 - ingot_fraction
    remaining_weight = remaining_fraction * target_weight
    
    solutions = []
    other_scraps = [name for name in SCRAP_MATERIALS.keys() if name != 'AA6061-I']
    
    # Filter scraps with available quantity
    available_scraps = [s for s in other_scraps if quantities.get(s, 0) > 0]
    
    if not available_scraps:
        return [], []
    
    print(f"    Testing combinations with available scraps...")
    
    # Try single scrap
    for scrap in available_scraps:
        max_frac = min(remaining_fraction, quantities.get(scrap, 0) / target_weight)
        if max_frac <= 0:
            continue
            
        other_fractions = {scrap: remaining_fraction}
        composition = calculate_mixed_composition(ingot_fraction, other_fractions)
        compliant, violations = check_6061_compliance(composition)
        
        # Check if we have enough quantity
        qty_needed = remaining_weight
        qty_available = quantities.get(scrap, 0)
        qty_feasible = qty_needed <= qty_available
        
        solutions.append({
            'other_materials': other_fractions,
            'composition': composition,
            'compliant': compliant,
            'violations': violations,
            'violation_count': len(violations),
            'comp_score': calculate_composition_score(composition),
            'qty_feasible': qty_feasible
        })
    
    # Try two scrap combinations
    for scrap1, scrap2 in combinations(available_scraps, 2):
        for split in np.arange(0.1, 1.0, 0.1):
            frac1 = remaining_fraction * split
            frac2 = remaining_fraction * (1 - split)
            
            # Check quantity feasibility
            qty1_needed = frac1 * target_weight
            qty2_needed = frac2 * target_weight
            qty1_available = quantities.get(scrap1, 0)
            qty2_available = quantities.get(scrap2, 0)
            
            other_fractions = {scrap1: frac1, scrap2: frac2}
            composition = calculate_mixed_composition(ingot_fraction, other_fractions)
            compliant, violations = check_6061_compliance(composition)
            
            qty_feasible = (qty1_needed <= qty1_available) and (qty2_needed <= qty2_available)
            
            solutions.append({
                'other_materials': other_fractions,
                'composition': composition,
                'compliant': compliant,
                'violations': violations,
                'violation_count': len(violations),
                'comp_score': calculate_composition_score(composition),
                'qty_feasible': qty_feasible
            })
    
    # Try three scrap combinations
    for combo in combinations(available_scraps, 3):
        for s1 in np.arange(0.2, 0.7, 0.2):
            for s2 in np.arange(0.1, 0.8 - s1, 0.2):
                s3 = 1.0 - s1 - s2
                if s3 >= 0.1:
                    other_fractions = {
                        combo[0]: remaining_fraction * s1,
                        combo[1]: remaining_fraction * s2,
                        combo[2]: remaining_fraction * s3
                    }
                    
                    # Check quantity feasibility
                    qty_feasible = True
                    for mat, frac in other_fractions.items():
                        if frac * target_weight > quantities.get(mat, 0):
                            qty_feasible = False
                            break
                    
                    composition = calculate_mixed_composition(ingot_fraction, other_fractions)
                    compliant, violations = check_6061_compliance(composition)
                    
                    solutions.append({
                        'other_materials': other_fractions,
                        'composition': composition,
                        'compliant': compliant,
                        'violations': violations,
                        'violation_count': len(violations),
                        'comp_score': calculate_composition_score(composition),
                        'qty_feasible': qty_feasible
                    })
    
    # Remove duplicates
    unique_solutions = []
    seen_compositions = set()
    
    for sol in solutions:
        comp_key = tuple(round(sol['composition'][elem], 3) for elem in ELEMENTS)
        if comp_key not in seen_compositions:
            seen_compositions.add(comp_key)
            unique_solutions.append(sol)
    
    # Sort: feasible compliant first, then non-feasible compliant, then non-compliant
    feasible_compliant = [s for s in unique_solutions if s['compliant'] and s['qty_feasible']]
    non_feasible_compliant = [s for s in unique_solutions if s['compliant'] and not s['qty_feasible']]
    non_compliant = [s for s in unique_solutions if not s['compliant']]
    
    feasible_compliant.sort(key=lambda x: x['comp_score'])
    non_feasible_compliant.sort(key=lambda x: x['comp_score'])
    non_compliant.sort(key=lambda x: (x['violation_count'], x['comp_score']))
    
    return feasible_compliant, non_feasible_compliant, non_compliant


